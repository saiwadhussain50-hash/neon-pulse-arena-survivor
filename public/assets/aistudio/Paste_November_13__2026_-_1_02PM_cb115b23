<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>NEON PULSE // Arena Survivor</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }

    body {
      background: #07080f;
      color: #e2e8f0;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      overflow: hidden;
      height: 100vh;
      width: 100vw;
      touch-action: none;
    }

    canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    /* HUD */
    #hud {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      pointer-events: none;
      padding: 14px 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 10;
    }

    .xp-bar-wrap {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 99px;
      overflow: hidden;
      border: 1px solid rgba(56, 189, 248, 0.25);
    }

    #xp-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #06b6d4, #3b82f6, #a855f7);
      box-shadow: 0 0 12px #38bdf8;
      transition: width 0.15s ease-out;
    }

    .hud-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 600;
      font-size: 14px;
      letter-spacing: 0.5px;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
    }

    .hud-group {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .pill {
      background: rgba(15, 23, 42, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 6px 12px;
      border-radius: 8px;
      backdrop-filter: blur(6px);
    }

    .hp-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .hp-bar {
      width: 130px;
      height: 10px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 6px;
      overflow: hidden;
    }

    #hp-fill {
      height: 100%;
      width: 100%;
      background: linear-gradient(90deg, #ef4444, #22c55e);
      transition: width 0.15s ease-out;
    }

    #mute-btn {
      pointer-events: auto;
      cursor: pointer;
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #e2e8f0;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
    }
    #mute-btn:hover {
      border-color: #38bdf8;
    }

    /* Overlays */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(5, 7, 15, 0.82);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 20;
      padding: 20px;
    }

    .hidden {
      display: none !important;
    }

    .modal {
      background: linear-gradient(145deg, #0f172a, #090d1a);
      border: 1px solid rgba(56, 189, 248, 0.3);
      box-shadow: 0 0 50px rgba(6, 182, 212, 0.15);
      border-radius: 18px;
      padding: 32px;
      max-width: 520px;
      width: 100%;
      text-align: center;
    }

    h1 {
      font-size: 2.2rem;
      letter-spacing: 2px;
      background: linear-gradient(90deg, #22d3ee, #818cf8, #f472b6);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 10px;
    }

    h2 {
      font-size: 1.6rem;
      color: #38bdf8;
      margin-bottom: 8px;
    }

    p.sub {
      color: #94a3b8;
      font-size: 0.95rem;
      line-height: 1.5;
      margin-bottom: 24px;
    }

    .btn-primary {
      background: linear-gradient(90deg, #06b6d4, #3b82f6);
      color: white;
      border: none;
      padding: 14px 34px;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 1px;
      border-radius: 10px;
      cursor: pointer;
      box-shadow: 0 0 24px rgba(6, 182, 212, 0.45);
      transition: transform 0.12s, box-shadow 0.12s;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 32px rgba(6, 182, 212, 0.7);
    }

    /* Upgrade Cards */
    #upgrade-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
      margin-top: 18px;
    }

    .card {
      background: rgba(30, 41, 59, 0.75);
      border: 1px solid rgba(148, 163, 184, 0.25);
      border-radius: 12px;
      padding: 16px 12px;
      cursor: pointer;
      transition: transform 0.15s, border-color 0.15s, background 0.15s;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .card:hover {
      transform: translateY(-4px);
      border-color: #22d3ee;
      background: rgba(30, 41, 59, 0.95);
      box-shadow: 0 8px 25px rgba(34, 211, 238, 0.2);
    }

    .card-icon {
      font-size: 1.8rem;
    }

    .card-title {
      font-weight: 700;
      font-size: 0.95rem;
      color: #f8fafc;
    }

    .card-desc {
      font-size: 0.8rem;
      color: #94a3b8;
      line-height: 1.35;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 18px 0 24px;
    }

    .stat-box {
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      padding: 12px;
    }

    .stat-label {
      font-size: 0.75rem;
      color: #64748b;
      text-transform: uppercase;
    }

    .stat-val {
      font-size: 1.3rem;
      font-weight: 700;
      color: #f8fafc;
      margin-top: 4px;
    }
  </style>
</head>
<body>

  <!-- HUD -->
  <div id="hud">
    <div class="xp-bar-wrap"><div id="xp-fill"></div></div>
    <div class="hud-row">
      <div class="hud-group">
        <div class="pill hp-wrap">
          <span>HP</span>
          <div class="hp-bar"><div id="hp-fill"></div></div>
          <span id="hp-text">100/100</span>
        </div>
        <div class="pill">LVL <span id="lvl-text">1</span></div>
      </div>
      <div class="hud-group">
        <div class="pill">TIME <span id="time-text">00:00</span></div>
        <div class="pill">SCORE <span id="score-text">0</span></div>
        <button id="mute-btn">🔊 Sound ON</button>
      </div>
    </div>
  </div>

  <!-- Start Screen -->
  <div id="start-screen" class="overlay">
    <div class="modal">
      <h1>NEON PULSE</h1>
      <p class="sub">
        Survive the endless geometric swarm.<br />
        Move with <strong>WASD / Arrow Keys</strong> or <strong>Click & Drag</strong>.<br />
        Weapons auto-fire. Collect glowing shards to evolve.
      </p>
      <p class="sub" style="margin-bottom: 20px; color: #38bdf8;">
        Best Score: <strong id="best-score-start">0</strong>
      </p>
      <button id="start-btn" class="btn-primary">ENTER ARENA</button>
    </div>
  </div>

  <!-- Level Up Modal -->
  <div id="levelup-screen" class="overlay hidden">
    <div class="modal" style="max-width: 580px;">
      <h2>SYSTEM UPGRADE</h2>
      <p class="sub" style="margin-bottom: 8px;">Choose one module to install:</p>
      <div id="upgrade-cards"></div>
    </div>
  </div>

  <!-- Game Over Modal -->
  <div id="gameover-screen" class="overlay hidden">
    <div class="modal">
      <h2 style="color: #f43f5e;">CORE BREACHED</h2>
      <p class="sub" style="margin-bottom: 10px;">Your vessel was overwhelmed by the swarm.</p>
      <div class="stats-grid">
        <div class="stat-box">
          <div class="stat-label">Final Score</div>
          <div class="stat-val" id="go-score">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Best Score</div>
          <div class="stat-val" id="go-best">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Time Survived</div>
          <div class="stat-val" id="go-time">00:00</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Level Reached</div>
          <div class="stat-val" id="go-lvl">1</div>
        </div>
      </div>
      <button id="restart-btn" class="btn-primary">PLAY AGAIN</button>
    </div>
  </div>

  <canvas id="game"></canvas>

  <script>
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');

    // UI Elements
    const startScreen = document.getElementById('start-screen');
    const levelupScreen = document.getElementById('levelup-screen');
    const gameoverScreen = document.getElementById('gameover-screen');
    const upgradeCardsEl = document.getElementById('upgrade-cards');
    const muteBtn = document.getElementById('mute-btn');

    const xpFill = document.getElementById('xp-fill');
    const hpFill = document.getElementById('hp-fill');
    const hpText = document.getElementById('hp-text');
    const lvlText = document.getElementById('lvl-text');
    const timeText = document.getElementById('time-text');
    const scoreText = document.getElementById('score-text');
    const bestScoreStart = document.getElementById('best-score-start');

    let W = (canvas.width = window.innerWidth);
    let H = (canvas.height = window.innerHeight);
    window.addEventListener('resize', () => {
      W = canvas.width = window.innerWidth;
      H = canvas.height = window.innerHeight;
    });

    // Simple Web Audio Synth (no external files required)
    const AudioSys = {
      ctx: null,
      muted: false,
      init() {
        if (!this.ctx) {
          this.ctx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (this.ctx.state === 'suspended') this.ctx.resume();
      },
      play(freq, type = 'sine', duration = 0.08, vol = 0.08, slide = 0) {
        if (this.muted || !this.ctx) return;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
        if (slide) {
          osc.frequency.exponentialRampToValueAtTime(
            Math.max(20, freq + slide),
            this.ctx.currentTime + duration
          );
        }
        gain.gain.setValueAtTime(vol, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + duration);
      }
    };

    muteBtn.addEventListener('click', () => {
      AudioSys.muted = !AudioSys.muted;
      muteBtn.textContent = AudioSys.muted ? '🔇 Muted' : '🔊 Sound ON';
    });

    // High Score
    let bestScore = Number(localStorage.getItem('neon_pulse_best') || 0);
    bestScoreStart.textContent = bestScore;

    // Input handling
    const keys = {};
    window.addEventListener('keydown', (e) => (keys[e.key.toLowerCase()] = true));
    window.addEventListener('keyup', (e) => (keys[e.key.toLowerCase()] = false));

    const pointer = { active: false, startX: 0, startY: 0, curX: 0, curY: 0 };
    canvas.addEventListener('pointerdown', (e) => {
      pointer.active = true;
      pointer.startX = e.clientX;
      pointer.startY = e.clientY;
      pointer.curX = e.clientX;
      pointer.curY = e.clientY;
    });
    window.addEventListener('pointermove', (e) => {
      if (!pointer.active) return;
      pointer.curX = e.clientX;
      pointer.curY = e.clientY;
    });
    window.addEventListener('pointerup', () => (pointer.active = false));
    window.addEventListener('pointercancel', () => (pointer.active = false));

    // Game State
    let state = 'menu'; // menu | playing | paused | gameover
    let player, bullets, enemies, gems, particles, floatTexts;
    let elapsed, score, spawnTimer, shootTimer, shakeTime;
    let camX = 0, camY = 0;

    const UPGRADES = [
      {
        id: 'firerate',
        icon: '⚡',
        title: 'Overclocked Core',
        desc: '+22% Attack Speed',
        apply: (p) => (p.fireDelay *= 0.8)
      },
      {
        id: 'multishot',
        icon: '🔱',
        title: 'Split Emitter',
        desc: '+1 Extra Projectile per shot',
        apply: (p) => (p.multishot += 1)
      },
      {
        id: 'damage',
        icon: '💥',
        title: 'Plasma Density',
        desc: '+35% Bullet Damage',
        apply: (p) => (p.damage = Math.round(p.damage * 1.35))
      },
      {
        id: 'pierce',
        icon: '🏹',
        title: 'Railgun Tip',
        desc: 'Bullets pierce +1 extra enemy',
        apply: (p) => (p.pierce += 1)
      },
      {
        id: 'speed',
        icon: '💨',
        title: 'Thruster Boost',
        desc: '+18% Movement Speed & +25% Magnet Range',
        apply: (p) => {
          p.speed *= 1.18;
          p.magnet *= 1.25;
        }
      },
      {
        id: 'orbit',
        icon: '🛡️',
        title: 'Orbital Blade',
        desc: 'Adds a spinning energy orb that damages enemies',
        apply: (p) => (p.orbitals += 1)
      },
      {
        id: 'vitality',
        icon: '❤️',
        title: 'Nano Repair',
        desc: '+30 Max HP & fully restore health',
        apply: (p) => {
          p.maxHp += 30;
          p.hp = p.maxHp;
        }
      }
    ];

    function resetGame() {
      player = {
        x: 0,
        y: 0,
        r: 14,
        speed: 230,
        hp: 100,
        maxHp: 100,
        xp: 0,
        nextXp: 10,
        level: 1,
        fireDelay: 0.42,
        damage: 20,
        multishot: 1,
        pierce: 1,
        magnet: 110,
        orbitals: 0,
        invuln: 0
      };
      bullets = [];
      enemies = [];
      gems = [];
      particles = [];
      floatTexts = [];
      elapsed = 0;
      score = 0;
      spawnTimer = 0;
      shootTimer = 0;
      shakeTime = 0;
      camX = player.x - W / 2;
      camY = player.y - H / 2;
      updateHUD();
    }

    function formatTime(sec) {
      const m = Math.floor(sec / 60).toString().padStart(2, '0');
      const s = Math.floor(sec % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    function updateHUD() {
      xpFill.style.width = `${Math.min(100, (player.xp / player.nextXp) * 100)}%`;
      hpFill.style.width = `${Math.max(0, (player.hp / player.maxHp) * 100)}%`;
      hpText.textContent = `${Math.ceil(player.hp)}/${player.maxHp}`;
      lvlText.textContent = player.level;
      timeText.textContent = formatTime(elapsed);
      scoreText.textContent = score;
    }

    function spawnParticles(x, y, color, count = 8, speed = 160) {
      for (let i = 0; i < count; i++) {
        const a = Math.random() * Math.PI * 2;
        const v = (0.3 + Math.random() * 0.7) * speed;
        particles.push({
          x,
          y,
          vx: Math.cos(a) * v,
          vy: Math.sin(a) * v,
          life: 0.35 + Math.random() * 0.25,
          maxLife: 0.6,
          r: 2 + Math.random() * 2.5,
          color
        });
      }
    }

    function addFloatText(x, y, text, color = '#fff') {
      floatTexts.push({ x, y, text, color, life: 0.65 });
    }

    function spawnEnemy() {
      const angle = Math.random() * Math.PI * 2;
      const dist = Math.hypot(W, H) * 0.55 + 60;
      const x = player.x + Math.cos(angle) * dist;
      const y = player.y + Math.sin(angle) * dist;

      const difficulty = 1 + elapsed / 35;
      const roll = Math.random();

      let type = 'chaser';
      let r = 13;
      let speed = 95 + Math.random() * 25;
      let hp = 24 * difficulty;
      let color = '#f43f5e';
      let xpVal = 2;

      if (elapsed > 20 && roll < 0.25) {
        type = 'dasher';
        r = 10;
        speed = 165 + Math.random() * 30;
        hp = 14 * difficulty;
        color = '#facc15';
        xpVal = 3;
      } else if (elapsed > 45 && roll > 0.82) {
        type = 'tank';
        r = 22;
        speed = 62;
        hp = 85 * difficulty;
        color = '#a855f7';
        xpVal = 7;
      }

      enemies.push({ x, y, r, speed, hp, maxHp: hp, color, type, xpVal, hitFlash: 0 });
    }

    function fireWeapon() {
      if (enemies.length === 0) return;

      // Find nearest enemy
      let nearest = null;
      let bestD = Infinity;
      for (const e of enemies) {
        const d = (e.x - player.x) ** 2 + (e.y - player.y) ** 2;
        if (d < bestD) {
          bestD = d;
          nearest = e;
        }
      }
      if (!nearest || bestD > 750 * 750) return;

      const baseAngle = Math.atan2(nearest.y - player.y, nearest.x - player.x);
      const count = player.multishot;
      const spread = 0.16;

      for (let i = 0; i < count; i++) {
        const offset = (i - (count - 1) / 2) * spread;
        const a = baseAngle + offset;
        bullets.push({
          x: player.x,
          y: player.y,
          vx: Math.cos(a) * 560,
          vy: Math.sin(a) * 560,
          r: 5,
          life: 1.4,
          damage: player.damage,
          pierce: player.pierce,
          hitSet: new Set()
        });
      }
      AudioSys.play(520, 'triangle', 0.06, 0.05, -240);
    }

    function triggerLevelUp() {
      state = 'paused';
      AudioSys.play(440, 'sine', 0.12, 0.1, 300);
      setTimeout(() => AudioSys.play(660, 'sine', 0.18, 0.1, 220), 90);

      // Pick 3 random upgrades
      const pool = [...UPGRADES].sort(() => Math.random() - 0.5).slice(0, 3);
      upgradeCardsEl.innerHTML = '';

      pool.forEach((upg) => {
        const card = document.createElement('div');
        card.className = 'card';
        card.innerHTML = `
          <div class="card-icon">${upg.icon}</div>
          <div class="card-title">${upg.title}</div>
          <div class="card-desc">${upg.desc}</div>
        `;
        card.addEventListener('click', () => {
          upg.apply(player);
          levelupScreen.classList.add('hidden');
          state = 'playing';
          updateHUD();
        });
        upgradeCardsEl.appendChild(card);
      });

      levelupScreen.classList.remove('hidden');
    }

    function endGame() {
      state = 'gameover';
      AudioSys.play(180, 'sawtooth', 0.35, 0.12, -130);
      if (score > bestScore) {
        bestScore = score;
        localStorage.setItem('neon_pulse_best', bestScore);
      }
      document.getElementById('go-score').textContent = score;
      document.getElementById('go-best').textContent = bestScore;
      document.getElementById('go-time').textContent = formatTime(elapsed);
      document.getElementById('go-lvl').textContent = player.level;
      gameoverScreen.classList.remove('hidden');
    }

    function update(dt) {
      if (state !== 'playing') return;

      elapsed += dt;
      if (player.invuln > 0) player.invuln -= dt;
      if (shakeTime > 0) shakeTime -= dt;

      // Movement
      let mx = 0, my = 0;
      if (keys['w'] || keys['arrowup']) my -= 1;
      if (keys['s'] || keys['arrowdown']) my += 1;
      if (keys['a'] || keys['arrowleft']) mx -= 1;
      if (keys['d'] || keys['arrowright']) mx += 1;

      if (mx === 0 && my === 0 && pointer.active) {
        const dx = pointer.curX - pointer.startX;
        const dy = pointer.curY - pointer.startY;
        const dist = Math.hypot(dx, dy);
        if (dist > 8) {
          mx = dx / dist;
          my = dy / dist;
        }
      }

      const mLen = Math.hypot(mx, my);
      if (mLen > 0) {
        player.x += (mx / mLen) * player.speed * dt;
        player.y += (my / mLen) * player.speed * dt;
      }

      // Smooth Camera
      const targetCamX = player.x - W / 2;
      const targetCamY = player.y - H / 2;
      camX += (targetCamX - camX) * Math.min(1, dt * 10);
      camY += (targetCamY - camY) * Math.min(1, dt * 10);

      // Spawning
      const spawnInterval = Math.max(0.16, 0.95 - elapsed * 0.008);
      spawnTimer -= dt;
      if (spawnTimer <= 0) {
        spawnEnemy();
        if (elapsed > 30 && Math.random() < 0.35) spawnEnemy();
        spawnTimer = spawnInterval;
      }

      // Auto-Shooting
      shootTimer -= dt;
      if (shootTimer <= 0) {
        fireWeapon();
        shootTimer = player.fireDelay;
      }

      // Orbitals
      const orbitAngles = [];
      for (let i = 0; i < player.orbitals; i++) {
        orbitAngles.push(elapsed * 3.4 + (i * Math.PI * 2) / player.orbitals);
      }

      // Update Bullets
      for (let i = bullets.length - 1; i >= 0; i--) {
        const b = bullets[i];
        b.x += b.vx * dt;
        b.y += b.vy * dt;
        b.life -= dt;
        if (b.life <= 0) bullets.splice(i, 1);
      }

      // Update Enemies
      for (let i = enemies.length - 1; i >= 0; i--) {
        const e = enemies[i];
        if (e.hitFlash > 0) e.hitFlash -= dt;

        const ang = Math.atan2(player.y - e.y, player.x - e.x);
        e.x += Math.cos(ang) * e.speed * dt;
        e.y += Math.sin(ang) * e.speed * dt;

        // Orbital collision
        for (const oa of orbitAngles) {
          const ox = player.x + Math.cos(oa) * 62;
          const oy = player.y + Math.sin(oa) * 62;
          if (Math.hypot(e.x - ox, e.y - oy) < e.r + 10) {
            e.hp -= 65 * dt;
            e.hitFlash = 0.08;
          }
        }

        // Bullet collision
        for (let j = bullets.length - 1; j >= 0; j--) {
          const b = bullets[j];
          if (b.hitSet.has(e)) continue;
          if (Math.hypot(e.x - b.x, e.y - b.y) < e.r + b.r) {
            e.hp -= b.damage;
            e.hitFlash = 0.1;
            b.hitSet.add(e);
            b.pierce -= 1;
            spawnParticles(b.x, b.y, '#38bdf8', 4, 90);
            addFloatText(e.x, e.y - e.r, b.damage, '#e2e8f0');
            if (b.pierce <= 0) bullets.splice(j, 1);
          }
        }

        // Enemy Death
        if (e.hp <= 0) {
          spawnParticles(e.x, e.y, e.color, 12, 180);
          AudioSys.play(160, 'square', 0.06, 0.04, -80);
          score += e.xpVal * 10;
          gems.push({ x: e.x, y: e.y, val: e.xpVal, r: 5 });
          enemies.splice(i, 1);
          continue;
        }

        // Player Collision
        if (Math.hypot(e.x - player.x, e.y - player.y) < e.r + player.r) {
          if (player.invuln <= 0) {
            player.hp -= 15;
            player.invuln = 0.45;
            shakeTime = 0.18;
            spawnParticles(player.x, player.y, '#ef4444', 10, 200);
            AudioSys.play(110, 'sawtooth', 0.14, 0.1, -50);
            if (player.hp <= 0) {
              player.hp = 0;
              updateHUD();
              endGame();
              return;
            }
          }
        }
      }

      // XP Gems
      for (let i = gems.length - 1; i >= 0; i--) {
        const g = gems[i];
        const dx = player.x - g.x;
        const dy = player.y - g.y;
        const d = Math.hypot(dx, dy);
        if (d < player.magnet) {
          const pull = 360 * (1 - d / player.magnet) + 120;
          g.x += (dx / d) * pull * dt;
          g.y += (dy / d) * pull * dt;
        }
        if (d < player.r + g.r + 6) {
          player.xp += g.val;
          AudioSys.play(780, 'sine', 0.05, 0.04, 160);
          gems.splice(i, 1);
          if (player.xp >= player.nextXp) {
            player.xp -= player.nextXp;
            player.level += 1;
            player.nextXp = Math.round(player.nextXp * 1.35 + 6);
            triggerLevelUp();
          }
        }
      }

      // Particles & Floating Text
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.life -= dt;
        if (p.life <= 0) particles.splice(i, 1);
      }

      for (let i = floatTexts.length - 1; i >= 0; i--) {
        const f = floatTexts[i];
        f.y -= 32 * dt;
        f.life -= dt;
        if (f.life <= 0) floatTexts.splice(i, 1);
      }

      updateHUD();
    }

    function draw() {
      ctx.fillStyle = '#07080f';
      ctx.fillRect(0, 0, W, H);

      ctx.save();
      let sx = 0, sy = 0;
      if (shakeTime > 0) {
        sx = (Math.random() - 0.5) * 10;
        sy = (Math.random() - 0.5) * 10;
      }
      ctx.translate(-camX + sx, -camY + sy);

      // Background Grid
      const gridSize = 70;
      const startX = Math.floor(camX / gridSize) * gridSize;
      const startY = Math.floor(camY / gridSize) * gridSize;
      ctx.strokeStyle = 'rgba(56, 189, 248, 0.06)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let x = startX; x < camX + W + gridSize; x += gridSize) {
        ctx.moveTo(x, camY);
        ctx.lineTo(x, camY + H);
      }
      for (let y = startY; y < camY + H + gridSize; y += gridSize) {
        ctx.moveTo(camX, y);
        ctx.lineTo(camX + W, y);
      }
      ctx.stroke();

      if (state !== 'menu') {
        // Gems
        for (const g of gems) {
          ctx.fillStyle = '#22d3ee';
          ctx.shadowColor = '#22d3ee';
          ctx.shadowBlur = 8;
          ctx.beginPath();
          ctx.moveTo(g.x, g.y - g.r);
          ctx.lineTo(g.x + g.r, g.y);
          ctx.lineTo(g.x, g.y + g.r);
          ctx.lineTo(g.x - g.r, g.y);
          ctx.closePath();
          ctx.fill();
        }
        ctx.shadowBlur = 0;

        // Bullets
        ctx.fillStyle = '#bae6fd';
        ctx.shadowColor = '#38bdf8';
        ctx.shadowBlur = 10;
        for (const b of bullets) {
          ctx.beginPath();
          ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.shadowBlur = 0;

        // Enemies
        for (const e of enemies) {
          ctx.fillStyle = e.hitFlash > 0 ? '#ffffff' : e.color;
          ctx.shadowColor = e.color;
          ctx.shadowBlur = 10;
          ctx.beginPath();
          if (e.type === 'dasher') {
            const ang = Math.atan2(player.y - e.y, player.x - e.x);
            ctx.moveTo(e.x + Math.cos(ang) * e.r * 1.4, e.y + Math.sin(ang) * e.r * 1.4);
            ctx.lineTo(e.x + Math.cos(ang + 2.3) * e.r, e.y + Math.sin(ang + 2.3) * e.r);
            ctx.lineTo(e.x + Math.cos(ang - 2.3) * e.r, e.y + Math.sin(ang - 2.3) * e.r);
            ctx.closePath();
          } else if (e.type === 'tank') {
            ctx.rect(e.x - e.r, e.y - e.r, e.r * 2, e.r * 2);
          } else {
            ctx.arc(e.x, e.y, e.r, 0, Math.PI * 2);
          }
          ctx.fill();
        }
        ctx.shadowBlur = 0;

        // Orbitals
        for (let i = 0; i < player.orbitals; i++) {
          const oa = elapsed * 3.4 + (i * Math.PI * 2) / player.orbitals;
          const ox = player.x + Math.cos(oa) * 62;
          const oy = player.y + Math.sin(oa) * 62;
          ctx.fillStyle = '#34d399';
          ctx.shadowColor = '#34d399';
          ctx.shadowBlur = 14;
          ctx.beginPath();
          ctx.arc(ox, oy, 8, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.shadowBlur = 0;

        // Player
        const blink = player.invuln > 0 && Math.floor(elapsed * 20) % 2 === 0;
        if (!blink) {
          ctx.fillStyle = '#38bdf8';
          ctx.shadowColor = '#06b6d4';
          ctx.shadowBlur = 18;
          ctx.beginPath();
          ctx.arc(player.x, player.y, player.r, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(player.x, player.y, player.r * 0.45, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.shadowBlur = 0;

        // Particles
        for (const p of particles) {
          ctx.globalAlpha = Math.max(0, p.life / p.maxLife);
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;

        // Floating Damage Text
        ctx.font = 'bold 13px sans-serif';
        ctx.textAlign = 'center';
        for (const f of floatTexts) {
          ctx.globalAlpha = Math.max(0, f.life / 0.65);
          ctx.fillStyle = f.color;
          ctx.fillText(f.text, f.x, f.y);
        }
        ctx.globalAlpha = 1;
      }

      ctx.restore();

      // Virtual Touch Joystick Visual
      if (state === 'playing' && pointer.active) {
        ctx.strokeStyle = 'rgba(56, 189, 248, 0.35)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(pointer.startX, pointer.startY, 36, 0, Math.PI * 2);
        ctx.stroke();

        ctx.fillStyle = 'rgba(56, 189, 248, 0.5)';
        ctx.beginPath();
        ctx.arc(pointer.curX, pointer.curY, 14, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // Main Loop
    let lastTime = performance.now();
    function loop(now) {
      const dt = Math.min(0.05, (now - lastTime) / 1000);
      lastTime = now;
      update(dt);
      draw();
      requestAnimationFrame(loop);
    }

    document.getElementById('start-btn').addEventListener('click', () => {
      AudioSys.init();
      resetGame();
      startScreen.classList.add('hidden');
      state = 'playing';
    });

    document.getElementById('restart-btn').addEventListener('click', () => {
      AudioSys.init();
      resetGame();
      gameoverScreen.classList.add('hidden');
      state = 'playing';
    });

    resetGame();
    requestAnimationFrame(loop);
  </script>
</body>
</html>